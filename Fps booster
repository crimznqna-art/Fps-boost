-- DRAGGABLE ENGINE (MOBILE & PC)
local Dragging, DragStart, StartPos, DragInput

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        Dragging = true
        DragStart = input.Position
        StartPos = MainFrame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                Dragging = false
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        DragInput = input
    end
end)

UIS.InputChanged:Connect(function(input)
    if Dragging and input == DragInput then
        local Delta = input.Position - DragStart
        MainFrame.Position = UDim2.new(
            StartPos.X.Scale,
            StartPos.X.Offset + Delta.X,
            StartPos.Y.Scale,
            StartPos.Y.Offset + Delta.Y
        )
    end
end)

-- PERFORMANCE OPTIMIZATION ENGINE
local function IsPlayerCharacter(object)
    if not SETTINGS.IgnoreCharacters then return false end
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character and object:IsDescendantOf(player.Character) then
            return true
        end
    end
    return false
end

local function OptimiseObject(Object)
    if IsPlayerCharacter(Object) then return end

    pcall(function()
        -- Particles, Beams, Trails
        if SETTINGS.DisableParticles then
            if Object:IsA("ParticleEmitter") or Object:IsA("Trail") or Object:IsA("Beam") or Object:IsA("Fire") or Object:IsA("Smoke") or Object:IsA("Sparkles") then
                Object.Enabled = false
            end
        end

        -- BaseParts & Shadows
        if Object:IsA("BasePart") then
            if SETTINGS.DisableShadows then
                Object.CastShadow = false
            end
            if SETTINGS.OptimizeMaterials and not Object:IsA("MeshPart") then
                Object.Material = Enum.Material.SmoothPlastic
                Object.Reflectance = 0
            end
        end

        -- Mesh Parts
        if Object:IsA("MeshPart") and SETTINGS.OptimizeMaterials then
            Object.Material = Enum.Material.SmoothPlastic
            Object.Reflectance = 0
            Object.RenderFidelity = Enum.RenderFidelity.Performance
        end

        -- Post Processing Lighting Effects
        if SETTINGS.DisablePostEffects then
            if Object:IsA("BloomEffect") or Object:IsA("BlurEffect") or Object:IsA("SunRaysEffect") or Object:IsA("DepthOfFieldEffect") or Object:IsA("ColorCorrectionEffect") then
                Object.Enabled = false
            end
        end

        -- Decals / Textures
        if Object:IsA("Decal") or Object:IsA("Texture") then
            if SETTINGS.OptimizeMaterials then
                Object.Transparency = 0.5
            end
        end
    end)
end

-- BATCH WORKSPACE OPTIMIZATION
task.spawn(function()
    StatusLabel.Text = "BOOST: OPTIMIZING"

    local Objects = workspace:GetDescendants()
    for i, Object in ipairs(Objects) do
        if not Active then break end

        OptimiseObject(Object)

        if i % SETTINGS.BatchSize == 0 then
            RunService.Heartbeat:Wait()
        end
    end

    -- LIGHTING ENGINE TWEAKS
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9000000000
        Lighting.Brightness = 1
        if SETTINGS.DisablePostEffects then
            Lighting.Technology = Enum.Technology.Compatibility
        end
    end)

    -- TERRAIN OPTIMIZATION
    if SETTINGS.ReduceWaterEffects then
        pcall(function()
            local Terrain = workspace:FindFirstChildOfClass("Terrain")
            if Terrain then
                Terrain.WaterWaveSize = 0
                Terrain.WaterWaveSpeed = 0
                Terrain.WaterReflectance = 0
                Terrain.WaterTransparency = 0
            end
        end)
    end

    -- LIGHTING CHILD EFFECTS
    for _, Object in ipairs(Lighting:GetChildren()) do
        OptimiseObject(Object)
    end

    StatusLabel.Text = "BOOST: ACTIVE"
    StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 150)
end)

-- AUTOMATIC MONITOR FOR NEWLY ADDED OBJECTS
local AddedConnection = workspace.DescendantAdded:Connect(function(Object)
    if Active then
        task.defer(function()
            if Active and Object.Parent then
                OptimiseObject(Object)
            end
        end)
    end
end)

-- STATS TRACKER (FPS, PING, MEMORY)
local Frames = 0
local TimePassed = 0

local FPSConnection = RunService.RenderStepped:Connect(function(dt)
    Frames += 1
    TimePassed += dt

    if TimePassed >= SETTINGS.UpdateInterval then
        local CurrentFPS = math.floor(Frames / TimePassed + 0.5)
        Frames = 0
        TimePassed = 0

        FPSLabel.Text = string.format("FPS: %d", CurrentFPS)

        if CurrentFPS >= 50 then
            FPSLabel.TextColor3 = Color3.fromRGB(100, 255, 140)
        elseif CurrentFPS >= 30 then
            FPSLabel.TextColor3 = Color3.fromRGB(255, 210, 90)
        else
            FPSLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
    end
end)

-- PING & MEMORY UPDATE LOOP
task.spawn(function()
    while Active and ScreenGui.Parent do
        pcall(function()
            local Ping = Player:GetNetworkPing() * 1000
            PingLabel.Text = string.format("PING: %.0f ms", Ping)

            local Memory = Stats:GetTotalMemoryUsageMb()
            MemoryLabel.Text = string.format("MEMORY: %.0f MB", Memory)

            if Memory > 1200 then
                MemoryLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
            else
                MemoryLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
            end
        end)

        task.wait(SETTINGS.UpdateInterval)
    end
end)

